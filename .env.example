# Obtain your own keys. Never share a populated .env. Values are read from the environment first, then this file.
# Seedance 2.5 providers (configure at least one)
FAL_KEY=
ENHANCOR_API_KEY=
# Depth preparation (Replicate: Depth Anything + SAM 3; Demucs when clean dialogue is on)
REPLICATE_API_TOKEN=
# Optional Hugging Face depth provider
HF_TOKEN=
# enhancor or fal. Blank = enhancor when ENHANCOR_API_KEY is set, else fal when FAL_KEY is set.
SEEDANCE_PROVIDER=
# fal reference-to-video task: auto | reference | editing | extension. "editing" modifies the prepared clip.
FAL_TASK=editing
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor only. Leave blank to use the automatic cloudflared callback tunnel. fal needs no webhook.
ENHANCOR_WEBHOOK_URL=
# Media hosting for Enhancor only. fal uploads to fal storage and ignores these settings.
# tmpfiles = temporary, expiring links (default). Catbox is PUBLIC and PERSISTENT. Opt in only by setting
# MEDIA_HOST=catbox or MEDIA_HOST_FALLBACKS=catbox. Empty fallbacks = never switch hosts.
MEDIA_HOST=tmpfiles
MEDIA_HOST_FALLBACKS=
CATBOX_USERHASH=
